# DearBook — dearbook.ca
# Shopify Storefront API credentials
# Suivre les étapes ci-dessous pour obtenir ces valeurs

SESSION_SECRET=remplacer_par_une_chaine_aleatoire_de_32_caracteres

# Ton domaine myshopify.com (PAS dearbook.ca — le domaine interne Shopify)
# Trouve-le dans : Admin Shopify → Paramètres → Domaines
PUBLIC_STORE_DOMAIN=dearbook.myshopify.com

# Token API Storefront (voir instructions dans README ou ci-dessous)
PUBLIC_STOREFRONT_API_TOKEN=ton_token_storefront_ici
PRIVATE_STOREFRONT_API_TOKEN=ton_token_prive_ici
PUBLIC_STOREFRONT_ID=ton_storefront_id_ici

# Domaine de checkout
PUBLIC_CHECKOUT_DOMAIN=dearbook.myshopify.com
